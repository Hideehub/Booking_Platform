# Copy to .env to override the defaults in docker-compose.yml / dev.py.
# In production (Render) set these as environment variables instead.

# Which settings module to load: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in prod. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@db:5432/booking
REDIS_URL=redis://redis:6379/0

# Paystack secret key (dashboard → Settings → API Keys). Use sk_test_… locally.
# Also used to verify webhook signatures. Required in prod.
PAYSTACK_SECRET_KEY=

# Prod only: comma-separated, with scheme, e.g. https://booking.onrender.com
CSRF_TRUSTED_ORIGINS=
