# Copy to .env to override the defaults in docker-compose.yml / dev.py.
# In production (Render) set these as environment variables instead.

# Which settings module to load: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in prod. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@db:5432/booking
REDIS_URL=redis://redis:6379/0

# Paystack secret key (dashboard → Settings → API Keys). Also used to verify
# webhook signatures. Required in prod. Locally, leave it commented out to use
# the dev fake key; an empty value would override it and every webhook would
# be rejected. Uncomment with a real sk_test_… key to try Paystack checkout.
# PAYSTACK_SECRET_KEY=sk_test_...

# Public base URL, used for links in emails. Required in prod.
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=Bookings <bookings@localhost>
# Prod only: SMTP as a URL, e.g. smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=

# Prod only: comma-separated, with scheme, e.g. https://booking.onrender.com
CSRF_TRUSTED_ORIGINS=

# Scheduled-job intervals in seconds (defaults: 60 / 60 / 300). The free
# deployment uses 900 for all three; see docs/decisions.md, decision 17.
# HOLD_SWEEP_SECONDS=60
# CONFIRMATION_BACKSTOP_SECONDS=60
# REMINDER_SWEEP_SECONDS=300

# Optional, used by `python manage.py seed_demo` (and on start in production).
# DEMO_OWNER_PASSWORD=
